              {
                "name": "company_id",
                "value": "",
                "type": "path",
                "description": "The company the counterpart belongs to"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new counterpart"
        },
        {
          "info": {
            "name": "Get a specific counterpart",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://integration.app.svc.cluster.local:4000/api/v1/companies/:company_id/counterparts/:id",
            "params": [
              {
                "name": "company_id",
                "value": "",
